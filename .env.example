# Healthspan API — configuration placeholders.
# Use `dotnet user-secrets set "<Key>" "<value>"` or real environment
# variables (env vars use double-underscore nesting, e.g. Stripe__SecretKey).
# NEVER commit real values; keep .env out of git (see .gitignore).

DbConnectionString=Server=localhost;Database=HealthspanDb;User ID=root;Password=***

# Google sign-in (optional)
GoogleClientId=your-client-id.apps.googleusercontent.com
GoogleClientSecret=your-c…cret
GoogleCallbackUri=https://localhost:5001/auth/google/callback
GoogleDefaultReturnUrl=https://localhost:5001
GoogleAllowedReturnUrls=https://localhost:5001

# Azure Document Intelligence OCR (optional)
AzureDocumentIntelligenceEnabled=false
AzureDocumentIntelligenceEndpoint=https://your-resource.cognitiveservices.azure.com/
AzureDocumentIntelligenceApiKey=your-r…-key

# Azure Blob Storage (optional; falls back to filesystem when disabled)
AzureBlobStorageEnabled=false
AzureBlobStorageConnectionString=your-blob-connection-string
AzureBlobStorageContainerName=blood-test-results

# LLM marker normalization (optional)
LlmMarkerNormalizationEnabled=false
LlmMarkerNormalizationProvider=OpenRouter
LlmMarkerNormalizationApiKey=your-o…-key
LlmMarkerNormalizationModel=your-model-id

# Stripe billing (optional)
Stripe__SecretKey=sk_test_xxx
Stripe__WebhookSigningSecret=whsec_xxx

# Local dev QA seed (Development only; Enabled=false in committed config)
DevQaSeed__Enabled=true
DevQaSeed__Email=qa@dev.local
DevQaSeed__Password=set-loc…tamp
